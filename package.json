{
  "name": "tivorah-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --turbopack -p 7456",
    "dev:webpack": "NEXT_DIST_DIR=.next-dev next dev -p 7456",
    "build": "next build",
    "theme:dark": "node scripts/build-dark-theme.mjs",
    "prebuild": "npm run env:check",
    "env:check": "tsx scripts/check-env.ts",
    "start": "next start -p 7456",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "node --import tsx --test $(find lib components app -name '*.test.ts' -not -path '*/node_modules/*')"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.7.4",
    "jsqr": "^1.4.0",
    "next": "^15.5.24",
    "posthog-js": "^1.438.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.4",
    "yup": "^1.7.1",
    "zustand": "^5.0.15",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@types/zxcvbn": "^4.4.5",
    "dotenv": "^16.6.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.8.2"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
