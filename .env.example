# Tivorah's public site is hosted at tivorah.com.
# Public values are exposed to the browser. Never put server secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:6001
NEXT_PUBLIC_SITE_URL=https://tivorah.com
NEXT_PUBLIC_MEDIA_CDN_HOST=media.tivorah.com

# App download destinations used by the website.
NEXT_PUBLIC_APP_DOWNLOAD_URL=https://tivorah.com/#download
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Native app-link verification (server-only; configure in Netlify).
# APPLE_TEAM_ID is the 10-character Team ID from Apple Developer membership.
APPLE_TEAM_ID=
APPLE_APP_BUNDLE_IDENTIFIER=com.tivorah.tivorah
# Use the SHA-256 fingerprint from Google Play App Signing for production.
# Separate multiple valid signing certificates with commas during rotation.
ANDROID_APP_PACKAGE_NAME=com.tivorah.tivorah
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
